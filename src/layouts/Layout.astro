---
import "../styles/global.css";
import { site } from "../data/site";
import Ridgeline from "../components/Ridgeline.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
// BASE_URL is "/" for a user site or "/<repo>" (no trailing slash) for a project site.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = [
  { label: "How it works", href: `${base}/#trailhead` },
  { label: "Buddies", href: `${base}/#buddies` },
  { label: "Themes", href: `${base}/#themes` },
  { label: "Pricing", href: `${base}/#pricing` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/app-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}/app-icon.png`} />
    <link
      rel="preload"
      href={`${base}/fonts/NationalPark-ExtraBold.ttf`}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}/fonts/NationalPark-Bold.ttf`}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2c3c5a" />
    <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={`${site.url}/app-icon.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="wrap">
        <a class="badge" href={`${base}/`} aria-label="Hiking Passport, home">
          <img src={`${base}/app-icon.png`} alt="" width="52" height="52" />
          <span class="badge-name">Hiking Passport</span>
        </a>
        <nav class="topnav" aria-label="Sections">
          <div class="navpill">
            {
              sections.map((s) => (
                <a class="navlink" href={s.href}>
                  {s.label}
                </a>
              ))
            }
          </div>
          <details class="navmenu">
            <summary>Menu</summary>
            <div class="navmenu-list">
              {
                sections.map((s) => (
                  <a class="navlink" href={s.href}>
                    {s.label}
                  </a>
                ))
              }
            </div>
          </details>
          <a class="cta" href={site.appStore}>Get the app</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <Ridgeline />
      <div class="footer-body">
        <div class="wrap footer-grid">
          <div class="footer-brand">
            <img
              src={`${base}/app-icon.png`}
              alt=""
              width="56"
              height="56"
              loading="lazy"
            />
            <div>
              <p class="footer-name">Hiking Passport</p>
              <p class="footer-tag">Made by one hiker, for hikers.</p>
            </div>
          </div>
          <div class="foot-links">
            <a href={site.support}>Support</a>
            <a href={site.privacy}>Privacy</a>
            <a href={site.instagram}>Instagram</a>
            <a href={site.tiktok}>TikTok</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div class="wrap footer-fine">
          <p>
            © {new Date().getFullYear()}{" "}
            <a href={site.maker.url}>{site.maker.name}</a>. Theme names are
            inspired by national parks, not affiliated with them.
          </p>
          <a class="totop" href="#top">Back to the trailhead</a>
        </div>
      </div>
    </footer>
    <script>
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Reveal on scroll
      const items = document.querySelectorAll<HTMLElement>(".reveal, .stagger");
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
        items.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) {
            el.classList.add("is-visible");
            io.unobserve(el);
          }
        });
      }

      // The ridgeline above the footer plants its flags when it scrolls into view,
      // and its far ranges drift a little slower than the page, like on lillyseay.com
      const ridge = document.querySelector<HTMLElement>(".ridge");
      if (ridge) {
        if (reduce || !("IntersectionObserver" in window)) {
          ridge.classList.add("is-visible");
        } else {
          const ro = new IntersectionObserver(
            ([e]) => {
              if (e.isIntersecting) {
                ridge.classList.add("is-visible");
                ro.disconnect();
              }
            },
            { threshold: 0.35 },
          );
          ro.observe(ridge);
        }
        const far = ridge.querySelectorAll<SVGElement>(".layer-1");
        const mid = ridge.querySelectorAll<SVGElement>(".layer-2");
        const onRidge = () => {
          if (reduce) return;
          const below = Math.min(
            0,
            ridge.getBoundingClientRect().top - window.innerHeight,
          );
          far.forEach(
            (el) => (el.style.transform = `translateY(${-below * 0.12}px)`),
          );
          mid.forEach(
            (el) => (el.style.transform = `translateY(${-below * 0.05}px)`),
          );
        };
        onRidge();
        window.addEventListener("scroll", onRidge, { passive: true });
      }

      // Hero headline: words rise out of a blur
      const h1 = document.querySelector<HTMLElement>(".hero h1");
      if (h1 && !reduce) {
        let i = 0;
        const wrap = (node: Node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const frag = document.createDocumentFragment();
            for (const part of (node.textContent ?? "").split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                frag.appendChild(document.createTextNode(" "));
              } else {
                const span = document.createElement("span");
                span.className = "w";
                span.style.setProperty("--i", String(i++));
                span.textContent = part;
                frag.appendChild(span);
              }
            }
            node.parentNode?.replaceChild(frag, node);
          } else if (
            node.nodeType === Node.ELEMENT_NODE &&
            (node as Element).tagName !== "BR"
          ) {
            Array.from(node.childNodes).forEach(wrap);
          }
        };
        Array.from(h1.childNodes).forEach(wrap);
        h1.classList.add("split");
      }

      // The menu closes when you tap or click anywhere outside it, or press Escape
      const menu = document.querySelector<HTMLDetailsElement>(".navmenu");
      if (menu) {
        document.addEventListener("pointerdown", (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") menu.open = false;
        });
      }

      // Top bar: flat at the top of the page, a floating glass pill once scrolled
      const topbar = document.querySelector<HTMLElement>(".topbar");
      const onBar = () =>
        topbar?.classList.toggle("scrolled", window.scrollY > 40);
      onBar();
      window.addEventListener("scroll", onBar, { passive: true });

      // In-page anchor links: drive the scroll ourselves. The browser's smooth
      // scroll gets cancelled when reveal animations fire mid-scroll.
      document.addEventListener("click", (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>(
          'a[href*="#"]',
        );
        if (!a) return;
        const url = new URL(a.href, location.href);
        if (url.pathname !== location.pathname || !url.hash) return;
        const el =
          url.hash === "#top"
            ? document.body
            : document.querySelector<HTMLElement>(url.hash);
        if (!el) return;
        e.preventDefault();
        a.closest("details")?.removeAttribute("open");
        history.pushState(null, "", url.hash);
        const target =
          url.hash === "#top"
            ? 0
            : Math.max(0, el.getBoundingClientRect().top + window.scrollY - 16);
        const behavior = "instant" as ScrollBehavior;
        if (reduce) {
          window.scrollTo({ top: target, behavior });
          return;
        }
        const start = window.scrollY;
        const dist = target - start;
        const dur = Math.min(1400, 450 + Math.abs(dist) * 0.06);
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          window.scrollTo({ top: start + dist * eased, behavior });
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    </script>
  </body>
</html>
