---
import Layout from "../layouts/Layout.astro";
import PassportHero from "../components/PassportHero.astro";
import Signpost from "@lucide/astro/icons/signpost";
import Smartphone from "@lucide/astro/icons/smartphone";
import Route from "@lucide/astro/icons/route";
import PawPrint from "@lucide/astro/icons/paw-print";
import Palette from "@lucide/astro/icons/palette";
import Watch from "@lucide/astro/icons/watch";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Ticket from "@lucide/astro/icons/ticket";
import Tent from "@lucide/astro/icons/tent";
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import Accessibility from "@lucide/astro/icons/accessibility";
import Target from "@lucide/astro/icons/target";
import Clock from "@lucide/astro/icons/clock";
import SlidersHorizontal from "@lucide/astro/icons/sliders-horizontal";
import BatteryLow from "@lucide/astro/icons/battery-low";
import Timer from "@lucide/astro/icons/timer";
import Mountain from "@lucide/astro/icons/mountain";
import MountainSnow from "@lucide/astro/icons/mountain-snow";
import Footprints from "@lucide/astro/icons/footprints";
import Carousel from "../components/Carousel.astro";
import {
  site,
  steps,
  shots,
  plan,
  story,
  buddies,
  points,
  watchShots,
  pricing,
} from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Lucide icons (ISC license), in the rounded, even-stroke style of the app's SF Symbols
const noticeIcons = {
  tent: Tent,
  heart: HeartPulse,
  watch: Watch,
  eye: Accessibility,
};
const tierIcons = [Target, Clock, SlidersHorizontal, BatteryLow, Timer];
const parks = [
  { id: "default", name: "Alpine", park: "The app's own", free: true },
  { id: "rainier", name: "Rainier", park: "Inspired by Mount Rainier" },
  { id: "redwood", name: "Redwood", park: "Inspired by Redwood" },
  {
    id: "voyageurs",
    name: "Voyageurs",
    park: "Inspired by Voyageurs' northern lights",
  },
  { id: "white-sands", name: "White Sands", park: "Inspired by White Sands" },
];
---

<Layout title={`${site.name}: ${site.tagline}`}>
  <PassportHero />

  <!-- Trailhead: how it works, as signs along a trail -->
  <section id="trailhead" class="trailhead">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Signpost class="eyebrow-icon" aria-hidden="true" />Trailhead
        </p>
        <h2>Four signs to the <em>summit</em></h2>
        <p class="sub">
          A passport for your hiking season, from the first goal to the last
          stamp
        </p>
      </div>
      <ol class="trail-steps stagger">
        {
          steps.map((s, i) => (
            <li class="trail-step">
              <div class="park-sign">
                <span class="sign-no">{i + 1}</span>
                <p class="sign-kind">{s.kind}</p>
              </div>
              <div class="card step-card">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why it exists -->
  <section id="story" class="story topo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Footprints class="eyebrow-icon" aria-hidden="true" />Why I built it
        </p>
        <h2>The plan bends. <em>Your goals don't.</em></h2>
      </div>
      <div class="story-body reveal">
        {story.body.map((para) => <p>{para}</p>)}
      </div>
      <div class="story-photos stagger">
        {
          story.photos.map((ph) => (
            <figure>
              <img
                src={`${base}${ph.image}`}
                alt={ph.alt}
                width="1050"
                height="1400"
                loading="lazy"
              />
              <figcaption>
                <strong>{ph.cap}</strong>
                <span>{ph.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <ul class="story-stats stagger">
        {
          story.stats.map((st) => (
            <li class="card">
              <strong>{st.value}</strong>
              <span>{st.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="story-close reveal">{story.close}</p>
      <p class="story-sign reveal">
        Lilly Seay, maker of Hiking Passport
      </p>
    </div>
  </section>

  <!-- Screens -->
  <section id="screens" class="screens">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Smartphone class="eyebrow-icon" aria-hidden="true" />Screenshots
        </p>
        <h2>Take a look <em>inside</em></h2>
      </div>
    </div>
    <Carousel
      label="App screenshots"
      items={shots.map((sh) => ({
        image: `${base}${sh.image}`,
        alt: sh.alt,
        title: sh.alt.split(". ")[0],
        blurb: sh.blurb,
      }))}
      width={591}
      height={1280}
    />
  </section>

  <!-- Plan -->
  <section id="plan" class="plan topo">
    <div class="wrap plan-grid">
      <div class="reveal">
        <p class="eyebrow">
          <Route class="eyebrow-icon" aria-hidden="true" />Training plan
        </p>
        <h2>More than one <em>way up</em></h2>
        {plan.body.map((para) => <p class="plan-copy">{para}</p>)}
        <ul class="ways" aria-label="Ways to train">
          {plan.ways.map((w) => <li>{w}</li>)}
        </ul>
      </div>
      <div class="glass tiers reveal">
        <p class="tiers-head">Every milestone, five ways</p>
        <ol class="stagger">
          {
            plan.tiers.map((t, i) => {
              const Icon = tierIcons[i];
              return (
                <li>
                  <span class="tier-icon" aria-hidden="true">
                    <Icon />
                  </span>
                  <div>
                    <strong>{t.name}</strong>
                    <span>{t.body}</span>
                  </div>
                </li>
              );
            })
          }
        </ol>
        <p class="tiers-note">
          This is not medical advice. Run your plan past your clinician.
        </p>
      </div>
    </div>
  </section>

  <!-- Buddies -->
  <section id="buddies" class="buddies">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <PawPrint class="eyebrow-icon" aria-hidden="true" />Hiking buddies
        </p>
        <h2>Pick a hiking <em>buddy</em></h2>
        <p class="sub">
          Six forest animals, each from a community that gets told the trail is
          not for them. They're friends who hike, not trainers or doctors, and
          they never scold.
        </p>
      </div>
      <ul class="buddy-grid stagger">
        {
          buddies.map((b, i) => (
            <li class="buddy-card" style={`--tint: ${b.tint}`}>
              <div class="patch">
                <img src={`${base}${b.art}`} alt="" loading="lazy" />
              </div>
              <h3>{b.name}</h3>
              <p class="buddy-species">{b.species}</p>
              <p class="buddy-note">{b.note}</p>
              <blockquote>“{b.quote}”</blockquote>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Themes -->
  <section id="themes" class="themes">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Palette class="eyebrow-icon" aria-hidden="true" />Passport themes
        </p>
        <h2>Custom passport <em>themes</em></h2>
        <p class="sub">
          Each one is a national park landscape with its own colors, terrain,
          and sky. Pick one and the passport up top changes with it, along
          with this page. In the app the sun sits where it really is for the
          time of day, stars and a moon come out at night, and the theme
          dresses your widgets, your watch, and your Home Screen icon, a tiny
          passport that opens into the full landscape.
        </p>
      </div>
      <ul class="park-grid stagger">
        {
          parks.map((p) => (
            <li>
              <button
                class="park"
                data-set-theme={p.id}
                aria-pressed={p.id === "default" ? "true" : "false"}
              >
                <img
                  src={`${base}/themes/theme-${p.id}.svg`}
                  alt=""
                  width="88"
                  height="88"
                  loading="lazy"
                />
                <span class="park-name">{p.name}</span>
                <span class="park-sub">{p.park}</span>
                {p.free ? (
                  <span class="park-tag">Free</span>
                ) : (
                  <span class="park-tag pro">Pro</span>
                )}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Watch and widgets -->
  <section id="wrist" class="wrist">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Watch class="eyebrow-icon" aria-hidden="true" />Apple Watch
        </p>
        <h2>Your passport, <em>on your wrist</em></h2>
        <p class="sub">
          The watch keeps its own copy, so it opens with your passport whether
          or not your phone came along. Cross a milestone off or stamp a summit
          from there.
        </p>
      </div>
    </div>
    <Carousel
      label="Apple Watch screenshots"
      variant="watch"
      items={watchShots.map((w) => ({
        image: `${base}${w.image}`,
        alt: w.alt,
        title: w.cap,
        blurb: w.blurb,
      }))}
      width={422}
      height={514}
    />
  </section>

  <!-- Made to stay yours -->
  <section id="yours" class="yours topo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <ShieldCheck class="eyebrow-icon" aria-hidden="true" />Ranger station
        </p>
        <h2>Made to <em>stay yours</em></h2>
      </div>
      <ul class="notice-grid stagger">
        {
          points.map((p) => (
            <li class="card notice">
              <span class="notice-icon" aria-hidden="true">
                {(() => {
                  const Icon = noticeIcons[p.icon as keyof typeof noticeIcons];
                  return <Icon />;
                })()}
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="pricing">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">
          <Ticket class="eyebrow-icon" aria-hidden="true" />Park entrance
        </p>
        <h2>What's free, and what <em>Pro</em> adds</h2>
      </div>
      <div class="permits stagger">
        <div class="permit">
          <div class="permit-head">
            <p class="permit-kind">Day pass</p>
            <h3>Free</h3>
            <p class="permit-price">$0</p>
          </div>
          <ul>
            {
              pricing.free.map((f) => (
                <li>
                  <Mountain class="permit-icon" aria-hidden="true" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="permit pro">
          <div class="permit-head">
            <p class="permit-kind">Season pass</p>
            <h3>Hiking Passport Pro</h3>
            <div class="permit-prices">
              {
                pricing.prices.map((p) => (
                  <p class="permit-price">
                    {p.price} <span>{p.per}</span>
                    <small>{p.note}</small>
                  </p>
                ))
              }
            </div>
          </div>
          <ul>
            {
              pricing.pro.map((f) => (
                <li>
                  <Mountain class="permit-icon" aria-hidden="true" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="plan-note reveal">{pricing.requirements}</p>
    </div>
  </section>

  <!-- Closing -->
  <section id="get" class="closing">
    <div class="wrap reveal">
      <div class="closing-stamp" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle
            cx="60"
            cy="60"
            r="52"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-dasharray="5 5"></circle>
          <MountainSnow
            x="38"
            y="31"
            width="44"
            height="44"
            stroke-width="1.9"
          />
          <text x="60" y="91" text-anchor="middle">2026 SEASON</text>
        </svg>
      </div>
      <h2 class="big">Your first stamp is <em>waiting up there.</em></h2>
      <p class="closing-sub">
        {site.status}. Want to hear the day it lands? Send me a note.
      </p>
      <div class="links">
        <span class="store-badge" aria-label="Coming soon to the App Store">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8A4.5 4.5 0 0 0 4.7 9.6c-1.6 2.8-.4 6.9 1.1 9.2.8 1.1 1.7 2.3 2.9 2.3s1.6-.8 3-.8 1.8.8 3 .7c1.3 0 2.1-1.1 2.8-2.3a10 10 0 0 0 1.3-2.6 4 4 0 0 1-2.4-3.5ZM14.2 5.8A4 4 0 0 0 15.1 3a4.1 4.1 0 0 0-2.7 1.4 3.8 3.8 0 0 0-1 2.7 3.4 3.4 0 0 0 2.8-1.3Z"
            ></path></svg
          >
          <span><small>Coming soon to the</small>App Store</span>
        </span>
        <a
          class="pill-link"
          href={`mailto:${site.email}?subject=${encodeURIComponent("Tell me when Hiking Passport launches")}`}
          >Email me at launch</a
        >
      </div>
    </div>
  </section>
</Layout>
