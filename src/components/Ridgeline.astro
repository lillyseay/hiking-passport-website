---
// Layered mountain range from lillyseay.com, where the front ridge's summits are the season's hikes.
// Shapes are generated with a seeded random walk so they look rugged but build identically every time.
import { ridgeSummits as summits } from "../data/site";

const W = 1440;
const H = 400;
const baseY = 340;
const peakY = (h: number) => baseY - (h / 100) * 250;

// Seeded PRNG (mulberry32)
const rng = (seed: number) => () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

type Pt = [number, number];
type Peak = { x: number; y: number; w: number };

// Each mountain is a cone with slopes that steepen toward the summit (pointed top, wide flaring
// base). A layer is the upper envelope of its mountains over a valley floor, plus gentle
// low-frequency waviness for rock. No high-frequency jitter, so nothing can look like a needle.
function mountainRange(
  seed: number,
  peaks: Peak[],
  valleyY: number,
  wave: number,
): string {
  const r = rng(seed);
  const phase1 = r() * Math.PI * 2;
  const phase2 = r() * Math.PI * 2;
  const freq1 = 0.006 + r() * 0.004;
  const freq2 = 0.017 + r() * 0.006;
  // Smooth value noise: random heights on coarse grids, blended between, for rocky ledges and
  // sub-peaks along the slopes without any single-point needles.
  const grid = 34;
  const cells = Math.ceil((W + 80) / grid) + 4;
  const noiseA = Array.from({ length: cells }, () => r() - 0.5);
  const noiseB = Array.from({ length: cells * 2 }, () => r() - 0.5);
  const noiseC = Array.from({ length: cells * 3 }, () => r() - 0.5);
  const smooth = (arr: number[], x: number, spacing: number) => {
    const fx = (x + 40) / spacing;
    const i = Math.floor(fx);
    const t = fx - i;
    const e = (1 - Math.cos(t * Math.PI)) / 2;
    return arr[i] * (1 - e) + arr[i + 1] * e;
  };
  const pts: Pt[] = [];
  for (let x = -40; x <= W + 40; x += 5) {
    let y = valleyY;
    let apexCloseness = 0;
    for (const p of peaks) {
      const d = Math.abs(x - p.x) / p.w;
      if (d >= 1) continue;
      // concave slope: steep near the summit, easing out at the base
      const yy = p.y + (valleyY - p.y) * Math.pow(d, 0.72);
      if (yy < y) {
        y = yy;
        apexCloseness = Math.max(apexCloseness, 1 - d);
      }
    }
    // Texture fades out at the very top so summits stay crisp, and at the floor so bases stay calm.
    const swell =
      Math.sin(x * freq1 + phase1) * 0.6 + Math.sin(x * freq2 + phase2) * 0.4;
    const ledges =
      smooth(noiseA, x, grid) * 3.2 +
      smooth(noiseB, x, grid / 2) * 1.8 +
      smooth(noiseC, x, grid / 3) * 0.9;
    const heightFactor = Math.min(1, (valleyY - y) / 90);
    const apexGuard = 1 - Math.pow(apexCloseness, 5);
    const amp = wave * heightFactor * apexGuard;
    pts.push([x, y + swell * amp + ledges * amp * 2.05]);
  }
  return (
    "M" +
    pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(" L ") +
    ` L ${W + 40} ${H + 10} L -40 ${H + 10} Z`
  );
}

// Background ranges: a few broad mountains, lower and softer the farther back.
function backgroundRange(
  seed: number,
  count: number,
  minY: number,
  maxY: number,
  valleyY: number,
  wave: number,
) {
  const r = rng(seed);
  const peaks: Peak[] = Array.from({ length: count }, (_, i) => ({
    x: ((i + 0.5 + (r() - 0.5) * 0.5) / count) * W,
    y: minY + r() * (maxY - minY),
    w: 150 + r() * 140,
  }));
  return mountainRange(seed * 7 + 1, peaks, valleyY, wave);
}

const frontPeaks: Peak[] = summits.map((s) => ({
  x: (s.x / 100) * W,
  y: peakY(s.height),
  w: 130 + s.height * 1.3, // taller summits get a wider base
}));
const frontPath = mountainRange(11, frontPeaks, baseY - 10, 9);
const layers = [
  backgroundRange(2, 6, 60, 130, 235, 8),
  backgroundRange(3, 6, 110, 180, 270, 8),
  backgroundRange(5, 7, 170, 230, 300, 8),
];
// Phones show a cropped view of the right side of the range, so the last summit's label needs
// its own position inside that viewBox.
const mob = { x: 880, y: 30, w: 560, h: 370 };
const lastSummit = summits[summits.length - 1];
const mobileLabel = {
  left: (((lastSummit.x / 100) * W - mob.x) / mob.w) * 100,
  bottom: ((mob.y + mob.h - peakY(lastSummit.height)) / mob.h) * 100,
};
const groundPath = `M-40 ${H + 10} L-40 ${baseY + 12} C 200 ${baseY} 480 ${baseY + 22} 760 ${baseY + 6} C 1000 ${baseY - 8} 1240 ${baseY + 18} ${W + 40} ${baseY + 4} L ${W + 40} ${H + 10} Z`;
---

<div class="ridge" aria-label="This season's summits">
  <svg
    class="ridge-desktop"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
  >
    <path class="layer layer-1" d={layers[0]}></path>
    <ellipse class="fog fog-a" cx="420" cy="250" rx="380" ry="26"></ellipse>
    <path class="layer layer-2" d={layers[1]}></path>
    <ellipse class="fog fog-b" cx="1080" cy="290" rx="420" ry="24"></ellipse>
    <path class="layer layer-3" d={layers[2]}></path>
    <path class="layer layer-front" d={frontPath}></path>
    <path class="ground" d={groundPath}></path>
    {
      summits.map((s, i) => {
        const px = (s.x / 100) * W;
        const py = peakY(s.height);
        return (
          <g
            class="summit-flag"
            style={`--i: ${i}`}
            transform={`translate(${px.toFixed(0)} ${py.toFixed(0)})`}
          >
            <line x1="0" y1="0" x2="0" y2="-42" />
            <path d="M0 -42 L26 -34 L0 -26 Z" />
            <circle cx="0" cy="0" r="5" />
          </g>
        );
      })
    }
  </svg>
  <svg
    class="ridge-mobile"
    viewBox={`${mob.x} ${mob.y} ${mob.w} ${mob.h}`}
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
  >
    <path class="layer layer-1" d={layers[0]}></path>
    <path class="layer layer-2" d={layers[1]}></path>
    <ellipse class="fog fog-b" cx="1080" cy="290" rx="420" ry="24"></ellipse>
    <path class="layer layer-3" d={layers[2]}></path>
    <path class="layer layer-front" d={frontPath}></path>
    <path class="ground" d={groundPath}></path>
    {
      (() => {
        const s = summits[summits.length - 1];
        const px = (s.x / 100) * W;
        const py = peakY(s.height);
        return (
          <g
            class="summit-flag"
            style="--i: 0"
            transform={`translate(${px.toFixed(0)} ${py.toFixed(0)})`}
          >
            <line x1="0" y1="0" x2="0" y2="-42" />
            <path d="M0 -42 L26 -34 L0 -26 Z" />
            <circle cx="0" cy="0" r="5" />
          </g>
        );
      })()
    }
  </svg>
  <div
    class="summit-label summit-label-mobile"
    style={`--x: ${mobileLabel.left.toFixed(1)}%; --y: ${mobileLabel.bottom.toFixed(1)}%; --i: 0`}
  >
    <span class="year">{lastSummit.year}</span>
    <span class="name">{lastSummit.label}</span>
  </div>
  <ol class="summit-labels">
    {
      summits.map((s, i) => (
        <li
          class="summit-label"
          style={`--x: ${s.x}%; --y: ${((H - peakY(s.height)) / H) * 100}%; --i: ${i}`}
        >
          <span class="year">{s.year}</span>
          <span class="name">{s.label}</span>
        </li>
      ))
    }
  </ol>
  <ol class="summit-list">
    {
      summits.map((s) => (
        <li>
          <span class="year">{s.year}</span> {s.label}
        </li>
      ))
    }
  </ol>
</div>
